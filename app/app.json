{
  "expo": {
    "name": "Lilachat",
    "slug": "lilachat",
    "version": "0.1.150",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lilachat.app",
      "versionCode": 151,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lilachat.constroad.com",
              "pathPrefix": "/unirse"
            },
            {
              "scheme": "https",
              "host": "lilachat.constroad.com",
              "pathPrefix": "/llamada"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6b38d4"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withConsultaDeLilaStore",
      [
        "expo-contacts",
        {
          "contactsPermission": "Lilachat usa tus contactos para mostrarte a quién invitar. Se leen en el teléfono y no se envían a ningún lado."
        }
      ],
      "expo-sharing",
      "expo-video",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.adapters.react.apploader.** { *; }"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Lilachat usa la cámara para leer el código QR con que vinculas tu computadora.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lilachat te pide desbloquear el teléfono antes de vincular una computadora."
        }
      ]
    ]
  }
}
