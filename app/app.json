{
  "expo": {
    "name": "Lilachat",
    "slug": "lilachat",
    "version": "0.1.189",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lilachat.app",
      "versionCode": 190,
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "lilachat.constroad.com",
              "pathPrefix": "/unirse"
            },
            {
              "scheme": "https",
              "host": "lilachat.constroad.com",
              "pathPrefix": "/llamada"
            },
            {
              "scheme": "https",
              "host": "lilachat.constroad.com",
              "pathPrefix": "/s/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "*/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "*/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6b38d4"
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withGradleMemory",
      "./plugins/withConsultaDeLilaStore",
      "./plugins/withMainActivityNewIntent",
      "./plugins/withCallPictureInPicture",
      "./plugins/withNativeStartup",
      [
        "expo-contacts",
        {
          "contactsPermission": "Lilachat usa tus contactos para mostrarte quién ya está en Lilachat y a quién invitar. Envía los números a su servidor solo para compararlos; no guarda tu agenda."
        }
      ],
      "expo-sharing",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundRecording": true,
          "microphonePermission": "Lilachat usa el micrófono para notas de voz, videos y llamadas."
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class expo.modules.adapters.react.apploader.** { *; }\n-keep class com.reactnativecommunity.webview.** { *; }",
            "packagingOptions": {
              "exclude": [
                "org/bouncycastle/pqc/crypto/picnic/**"
              ]
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-background-task",
      [
        "expo-camera",
        {
          "cameraPermission": "Lilachat usa la cámara para fotos y videos del chat, informes y visitas, videollamadas y el código QR con que vinculas tu computadora.",
          "microphonePermission": "Lilachat usa el micrófono para grabar videos con sonido y para las videollamadas.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Lilachat usa Face ID para desbloquear la app, si activas el bloqueo, y antes de vincular una computadora."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Lilachat usa tu ubicación cuando la compartes en un chat (también en tiempo real, hasta que la detengas), para el sello de tus fotos y en informes, visitas y el mapa de obra.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://lilachat.constroad.com/api/ota/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "codeSigningCertificate": "./certs/certificate.crt",
      "codeSigningMetadata": {
        "keyid": "main",
        "alg": "rsa-v1_5-sha256"
      }
    }
  }
}
