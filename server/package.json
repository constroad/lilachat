{
  "name": "@lilachat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && node build.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build --workspace=@lilachat/shared",
    "prebuild": "npm run build --workspace=@lilachat/shared",
    "disco:init": "tsx src/discoInit.ts",
    "medios:init": "tsx src/mediaInit.ts"
  },
  "dependencies": {
    "@lilachat/shared": "*",
    "express": "^4.21.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "sharp": "0.35.5",
    "socket.io": "^4.8.3",
    "structured-headers": "^2.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
