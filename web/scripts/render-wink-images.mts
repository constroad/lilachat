/**
 * Renders the wink art as images for the app (José, 21/10: the pig looked slow
 * and clumsy on Android, smooth on the web). On Android, react-native-svg draws
 * each SVG into a bitmap as big as its view and throws it away on every
 * `invalidate()`: a sketch of ~20 full-screen part layers redrew ~20 big
 * bitmaps per frame (measured: 14 fps, every frame a slow bitmap upload). An
 * image is decoded once and moving it costs nothing, so the app plays the same
 * timeline with one small image per part, cropped to its own box
 * (`WinkArtPart.box`). The web keeps the live SVG.
 *
 * Writes `app/assets/guinos/<art>-<part>.webp`, a tile per wink for the
 * thumbnails (`<art>-tile.webp`) and `app/src/chat/winkImages.ts`.
 *
 *   npx tsx web/scripts/render-wink-images.mts --playwright <node_modules/playwright-core> --chrome <chrome executable>
 */
import { execFileSync } from 'node:child_process';
import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { dirname, join } from 'node:path';
import { fileURLToPath, pathToFileURL } from 'node:url';
import { WINK_ART, WINK_PROPS, type WinkArt } from '../../shared/src/winkArt.ts';

const args = Object.fromEntries(process.argv.slice(2).reduce<string[][]>((pairs, value, index, all) => (value.startsWith('--') ? [...pairs, [value.slice(2), all[index + 1]!]] : pairs), []));
const { chromium } = await import(pathToFileURL(join(args.playwright!, 'index.mjs')).href);
const root = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
const assets = join(root, 'app', 'assets', 'guinos');
const output = join(root, 'app', 'src', 'chat', 'winkImages.ts');

/** Pixels per viewBox unit: sharp at the size a character plays on a phone (about 1 100 px wide). */
const CHARACTER_PX_PER_UNIT = 4.5;
/** Props grow more (the STOP paddle fills the screen): a bit more detail. */
const PROP_PX_PER_UNIT = 6;
/** The thumbnails (64 dp cards, 46 dp panel tiles): 3x of the biggest. */
const TILE_PX = 192;
const WEBP_QUALITY = '88';

const svgOf = (art: WinkArt, viewBox: string, width: number, height: number, markup: string) =>
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${viewBox}" width="${width}" height="${height}">${art.defs ? `<defs>${art.defs}</defs>` : ''}${markup}</svg>`;

const browser = await chromium.launch({ executablePath: args.chrome, headless: true });
const page = await browser.newPage({ deviceScaleFactor: 1 });
const work = mkdtempSync(join(tmpdir(), 'wink-images-'));
mkdirSync(assets, { recursive: true });

/** One SVG to a transparent WebP of exactly that size. */
async function render(svg: string, file: string): Promise<void> {
  await page.setContent(`<html><body style="margin:0;background:transparent">${svg}</body></html>`);
  const png = join(work, 'part.png');
  await page.locator('svg').screenshot({ path: png, omitBackground: true });
  execFileSync('cwebp', ['-quiet', '-q', WEBP_QUALITY, '-alpha_q', '100', png, '-o', join(assets, file)]);
}

type Entry = { id: string; parts: string[]; tile: boolean };
const entries: Entry[] = [];
try {
  const all = [...Object.entries(WINK_ART).map(([id, art]) => ({ id, art, unit: CHARACTER_PX_PER_UNIT })), ...Object.entries(WINK_PROPS).map(([id, art]) => ({ id, art, unit: PROP_PX_PER_UNIT }))];
  for (const { id, art, unit } of all) {
    const parts: string[] = [];
    for (const part of art.parts) {
      const [x, y, width, height] = part.box;
      await render(svgOf(art, `${x} ${y} ${width} ${height}`, Math.ceil(width * unit), Math.ceil(height * unit), part.markup), `${id}-${part.part}.webp`);
      parts.push(part.part);
    }
    const [, , viewWidth = 1, viewHeight = 1] = art.viewBox.split(/\s+/).map(Number);
    const tileHeight = Math.round((TILE_PX * viewHeight) / viewWidth);
    await render(svgOf(art, art.viewBox, TILE_PX, tileHeight, art.parts.map((part) => part.markup).join('')), `${id}-tile.webp`);
    entries.push({ id, parts, tile: true });
    console.log(id, parts.length, 'parts');
  }
} finally {
  await browser.close();
  rmSync(work, { recursive: true, force: true });
}

const line = (entry: Entry) =>
  `  '${entry.id}': {\n    tile: require('../../assets/guinos/${entry.id}-tile.webp'),\n    parts: {\n${entry.parts.map((part) => `      '${part}': require('../../assets/guinos/${entry.id}-${part}.webp'),`).join('\n')}\n    },\n  },`;
writeFileSync(
  output,
  `/**
 * GENERATED by \`web/scripts/render-wink-images.mts\` (do not edit by hand): the
 * wink art as images, one per part cropped to its box, and a tile per wink for
 * the thumbnails. Android redraws a live SVG on every frame; an image is
 * decoded once.
 */
import type { RigPart } from '@lilachat/shared';

export type WinkImages = { tile: number; parts: Partial<Record<RigPart, number>> };

export const WINK_IMAGES: Record<string, WinkImages> = {
${entries.map(line).join('\n')}
};
`
);
console.log('written', output, entries.length);
